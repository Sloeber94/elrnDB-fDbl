[[30,1,262144,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Release the switch trim/support.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223003341.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[30,1,262144,"<p>1. Uncouple the switch unit (1a) from the trim/support (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223003342.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[30,1,262144,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check the condition of the trim/support.</p><p>Match the switch unit with the trim/support.</p><p>Fit the trim/support in its housing.</p>"]]