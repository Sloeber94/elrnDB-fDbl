[[63,7,1024,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Rotate the moving section and remove the rear parcel shelf.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223003375.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,7,1024,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Place the rear parcel shelf in position.</p><p>1. Match the rear parcel shelf pins (1a) with the centerings on the rear parcel shelf supports (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223003376.jpg\" alt=\"\" loading=\"lazy\"></figure>"]]