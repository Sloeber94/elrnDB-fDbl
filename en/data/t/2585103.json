[[63,7,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Open the bonnet.</p><p>1. Open the safety stop.</p><p>2. Support the bonnet, and remove the rod.</p><p>Close the bonnet lid.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223003289.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,7,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Open the bonnet and fit the stay.</p><p>Close the safety stop.</p><p>Close the bonnet lid.</p>"]]