[[63,7,1024,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Prise out the retaining clip.</p><p>2. Insert the key and remove the key barrel from its seating.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223003199.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,7,1024,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Fit the retaining clip.</p><p>2. Insert the key barrel in its seating until it clicks into place.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223003200.jpg\" alt=\"\" loading=\"lazy\"></figure>"]]