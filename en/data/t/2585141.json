[[63,7,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Disconnect the battery negative terminal.</p><p>1. Remove the courtesy light (1a) from the housing and disconnect the electrical connector (1b).</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/223000694.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>1b</p></td><td><p>Data not available yet</p></td><td colspan=\"1\"></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223003351.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,7,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Connect the courtesy light electrical connector.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/223000694.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>-</p></td><td><p>Data not available yet</p></td><td colspan=\"1\"></td></tr></table></div><p>Fit the courtesy light in its housing and connect the negative battery terminal.</p>"]]