[[1,7,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the safety clip.</p><p>2. Prise up the injector.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/223001855.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,7,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Before refitting, replace the seals.</p><p>Fit the injector by pressing lightly into the seat on the manifold.</p><p>Remove the safety clip.</p>"],[4,7,0,"<p><a href=\"#/2584246\">Op. 1056B68 SET OF INJECTORS - R + R WITH FUEL MANIFOLD PIPE REMOVED - INCLUDES SEAL REPLACEMENT</a>.</p>"],[2,7,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove clip (1a) and disconnect injector (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/199001602.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,7,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Refit the injector in its seat and secure it using the clip.</p>"]]